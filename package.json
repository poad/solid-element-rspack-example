{
  "name": "solid-element-rspack-example",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "rsbuild build",
    "dev": "rsbuild dev --open",
    "lint": "oxfmt --check && oxlint",
    "lint-fix": "oxfmt && oxlint --fix",
    "preview": "rsbuild preview",
    "test": "rstest",
    "test:watch": "rstest --watch",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "component-register": "^0.8.8",
    "solid-element": "^1.9.2",
    "solid-js": "^1.9.15"
  },
  "devDependencies": {
    "@rsbuild/core": "^2.2.11",
    "@rsbuild/plugin-babel": "^2.1.0",
    "@rsbuild/plugin-solid": "^1.2.2",
    "@rstest/core": "^0.12.3",
    "@storybook/addon-docs": "^10.6.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/node": "^26.6.4",
    "babel-preset-solid": "^1.9.15",
    "eslint-plugin-solid": "^0.18.0",
    "eslint-plugin-storybook": "^10.6.1",
    "globals": "^17.13.0",
    "happy-dom": "^20.14.5",
    "jiti": "^2.7.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "storybook": "^10.6.1",
    "storybook-solidjs-vite": "^10.7.2",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.11.1",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^24.21.0",
      "onFail": "download"
    }
  }
}
