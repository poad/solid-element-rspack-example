{
  "name": "solid-element-rspack-example",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "rsbuild build",
    "dev": "rsbuild dev --open",
    "lint": "oxfmt --check && oxlint",
    "lint-fix": "oxfmt && oxlint --fix",
    "preview": "rsbuild preview",
    "test": "rstest",
    "test:watch": "rstest --watch",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@solidjs/element": "^2.0.2",
    "@solidjs/web": "^2.0.4",
    "component-register": "^0.8.8",
    "solid-js": "^2.0.4"
  },
  "devDependencies": {
    "@rsbuild/core": "^2.3.4",
    "@rsbuild/plugin-babel": "^2.1.0",
    "@rsbuild/plugin-solid": "^2.1.1",
    "@rspack/cli": "^2.3.4",
    "@rstest/core": "^0.12.6",
    "@storybook/addon-docs": "^10.6.7",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@types/node": "^26.6.6",
    "babel-preset-solid": "^1.9.19",
    "eslint-plugin-solid": "^0.20.1",
    "eslint-plugin-storybook": "^10.6.7",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "solid-loader": "^1.0.1",
    "storybook": "^10.6.7",
    "storybook-solidjs-vite": "^10.7.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.23.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^26.13.1",
      "onFail": "download"
    }
  }
